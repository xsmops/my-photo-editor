<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.photoeditor.controller.EditorController">

    <center>
        <ImageView fx:id="imageView"
                   preserveRatio="true"
                   fitWidth="800"/>
    </center>

    <right>
        <VBox spacing="15" alignment="CENTER" prefWidth="200">

            <Label text="Brightness"/>
            <Slider fx:id="brightnessSlider"
            min="-1"
            max="1"
            value="0"
            blockIncrement="0.01"
            showTickMarks="true"
            majorTickUnit="0.5"/>

            <Label text="Contrast"/>
            <Slider fx:id="contrastSlider"
                    min="-1"
                    max="1"
                    value="0"
                    blockIncrement="0.01"
                    showTickMarks="true"
                    majorTickUnit="0.25"/>

            <Label text="Saturation"/>
            <Slider fx:id="saturationSlider"
                    min="-1"
                    max="1"
                    blockIncrement="0.01"
                    showTickMarks="true"
                    majorTickUnit="0.5"/>

            <Label text="Hue"/>
            <Slider fx:id="hueSlider"
                    min="-1"
                    max="1"
                    blockIncrement="0.01"
                    showTickMarks="true"
                    majorTickUnit="0.5"/>

        </VBox>
    </right>

</BorderPane>